{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.elfa/mcp",
  "description": "Get events, answers, verdicts and alerts from social and web data.",
  "version": "5.1.0",
  "repository": {
    "url": "https://github.com/elfa-ai/mcp",
    "source": "github"
  },
  "websiteUrl": "https://docs.elfa.ai",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@elfa-ai/mcp",
      "version": "5.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "ELFA_API_KEY",
          "description": "Elfa API key from https://dev.elfa.ai",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.elfa.ai/mcp"
    }
  ]
}
